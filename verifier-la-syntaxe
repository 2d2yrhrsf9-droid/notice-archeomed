#!/usr/bin/env python3
"""Un filet, faute de PHP sur la machine de travail.

Il n'y a ni PHP, ni Docker, ni Homebrew sur le poste où ce plugin s'écrit :
« php -l » n'est pas jouable. Ce contrôle ne le remplace pas — il ne connaît
ni la grammaire du langage ni ses fonctions —, mais il attrape les fautes qui
arrivent vraiment quand on modifie un fichier par morceaux.

    ./verifier-la-syntaxe notice-archeomed/*.php

Rend 1 si quelque chose cloche. **Un passage vert ne dispense pas d'installer
sur un site d'essai avant la production.**

## Ce qu'il attrape, et pourquoi

La version précédente comptait les délimiteurs sans lire ce qu'elle
traversait. Elle a laissé passer une erreur fatale bien réelle — une
apostrophe française dans une chaîne à guillemets simples,
« 'Formulaire des notices d'archéologie' » — en affichant un vert
rassurant. La chaîne s'y refermait à « d' », le reste devenait du code, et
les guillemets égarés se réappariaient plus loin dans le fichier : la pile
retombait juste, le compte était bon, et le plugin ne chargeait pas.

D'où un analyseur qui traverse le code comme PHP le lit :

- il entre et sort des balises PHP — le HTML, la CSS et le JavaScript des
  pages portent des accolades qui ne le regardent pas ;
- il saute les commentaires, de ligne comme de bloc ;
- il traverse les chaînes en respectant l'échappement, et **signale celle à
  guillemets simples qui franchit une fin de ligne** : c'est la signature de
  l'apostrophe égarée. À guillemets doubles il se tait, une requête SQL sur
  plusieurs lignes étant un idiome ordinaire — un filet qui crie au loup ne
  se lit plus ;
- il saute les heredocs et nowdocs ;
- il équilibre parenthèses, crochets et accolades **en vérifiant qu'ils se
  correspondent**, et non seulement qu'ils sont en nombre égal.

Ce qu'il ne sait toujours pas faire : la grammaire. Un appel à une fonction
qui n'existe pas, un argument de trop, une méthode statique appelée comme une
autre — rien de tout cela ne se voit ici.
"""

import re
import sys
import pathlib

FERMANTS = {')': '(', ']': '[', '}': '{'}


def analyser(source):
    """Rend la liste des fautes : (ligne, ce qui cloche)."""
    return analyser_et_masquer(source)[0]


def analyser_et_masquer(source):
    """Les fautes, et le code PHP seul.

    Le code seul a la longueur de la source : tout ce qui n'est pas du code —
    le HTML hors des balises, les commentaires, les chaînes, les heredocs —
    y est remplacé par des espaces, les fins de ligne gardées pour que les
    numéros de ligne restent justes. C'est ce qu'on lit quand on cherche des
    déclarations : un « class Piece » dans le JavaScript d'une page ou dans
    une chaîne n'en est pas une.
    """
    i, n, ligne = 0, len(source), 1
    dans_php = False
    pile, fautes = [], []
    code = ['\n' if c == '\n' else ' ' for c in source]

    while i < n:
        c = source[i]

        if c == '\n':
            ligne += 1
            i += 1
            continue

        # — Hors des balises, tout est du texte —
        if not dans_php:
            ouvertures = [p for p in (source.find('<?php', i), source.find('<?=', i)) if p >= 0]
            if not ouvertures:
                break
            j = min(ouvertures)
            ligne += source.count('\n', i, j)
            i = j + (5 if source.startswith('<?php', j) else 3)
            dans_php = True
            continue

        if source.startswith('?>', i):
            dans_php = False
            i += 2
            continue

        # — Les commentaires —
        if source.startswith('//', i) or c == '#':
            j = source.find('\n', i)
            i = j if j >= 0 else n
            continue
        if source.startswith('/*', i):
            j = source.find('*/', i + 2)
            if j < 0:
                fautes.append((ligne, 'commentaire /* jamais fermé'))
                break
            ligne += source.count('\n', i, j)
            i = j + 2
            continue

        # — Heredoc et nowdoc —
        if source.startswith('<<<', i):
            fin_ligne = source.find('\n', i)
            if fin_ligne < 0:
                break
            marqueur = source[i + 3:fin_ligne].strip().strip('"\'')
            j = source.find('\n' + marqueur, fin_ligne)
            if j < 0:
                fautes.append((ligne, f'heredoc « {marqueur} » jamais fermé'))
                break
            ligne += source.count('\n', i, j)
            i = j + len(marqueur) + 1
            continue

        # — Les chaînes —
        if c in ("'", '"'):
            depart = ligne
            j = i + 1
            while j < n:
                if source[j] == '\\':
                    j += 2
                    continue
                if source[j] == '\n':
                    ligne += 1
                if source[j] == c:
                    break
                j += 1
            if j >= n:
                fautes.append((depart, f'chaîne ouverte par {c} et jamais fermée'))
                break
            # Une chaîne à guillemets doubles qui court sur plusieurs lignes
            # est un idiome ordinaire — une requête SQL, un bloc de HTML. À
            # guillemets simples, en revanche, c'est presque toujours une
            # apostrophe française qui a refermé la chaîne trop tôt.
            if ligne != depart and c == "'":
                fautes.append((
                    depart,
                    f'chaîne simple traversant {ligne - depart} fin(s) de ligne — '
                    f'apostrophe non échappée ?'
                ))
            i = j + 1
            continue

        # — Les délimiteurs —
        code[i] = c
        if c in '([{':
            pile.append((c, ligne))
            i += 1
            continue
        if c in ')]}':
            if not pile:
                fautes.append((ligne, f'« {c} » sans ouvrant'))
                i += 1
                continue
            ouvrant, ligne_ouvrante = pile.pop()
            if ouvrant != FERMANTS[c]:
                fautes.append((
                    ligne,
                    f'« {c} » ferme un « {ouvrant} » ouvert ligne {ligne_ouvrante}'
                ))
            i += 1
            continue

        i += 1

    for ouvrant, ligne_ouvrante in pile:
        fautes.append((ligne_ouvrante, f'« {ouvrant} » jamais fermé'))

    return sorted(fautes), ''.join(code)


DECLARATION = re.compile(
    r'\b(?:final\s+|abstract\s+)*(?:class|interface|trait)\s+([A-Za-z_][A-Za-z0-9_]*)'
)


def declarations(code):
    """Les classes, interfaces et traits déclarés sans condition, avec leur ligne.

    Une liste et non un ensemble : un nom déclaré deux fois dans le même
    fichier est un doublon comme un autre, et un ensemble l'aurait réduit à
    une seule entrée.

    Seules comptent les déclarations hors de toute accolade. Celle qui se
    trouve dans un bloc — le plus souvent « if ( ! class_exists( … ) ) » —
    ne s'exécute qu'à la condition posée, et deux fichiers peuvent la porter
    sans que PHP s'en plaigne.
    """
    profondeur = []
    p = 0
    for c in code:
        profondeur.append(p)
        if c == '{':
            p += 1
        elif c == '}':
            p = max(0, p - 1)
    out = []
    for m in DECLARATION.finditer(code):
        if profondeur[m.start()] == 0:
            out.append((m.group(1), code.count('\n', 0, m.start()) + 1))
    return out


def doublons(fichiers):
    """Les noms déclarés plus d'une fois dans l'ensemble des fichiers.

    PHP s'arrête net sur « Cannot declare class … because the name is already
    in use » : pas une dégradation, un arrêt, et le site avec. Le contrôle ne
    peut pas exécuter PHP sur ce poste, mais un nom déclaré deux fois se voit
    sans l'exécuter — et c'est ainsi qu'une classe neuve a un jour pris le nom
    de la classe principale du plugin, qui le tient de son shortcode.

    Le contrôle ne sait pas quels fichiers se chargent l'un l'autre : il
    suppose que tous ceux qu'on lui donne se chargent ensemble, ce qui est le
    cas d'un plugin.
    """
    ou = {}
    for fichier, code in fichiers:
        for nom, ligne in declarations(code):
            ou.setdefault(nom, []).append(f'{fichier.name}:{ligne}')
    return {nom: lieux for nom, lieux in ou.items() if len(lieux) > 1}


def main(chemins):
    if not chemins:
        print(__doc__.strip().split('\n\n')[2].strip())
        return 1
    ennuis = 0
    lus = []
    for chemin in chemins:
        fichier = pathlib.Path(chemin)
        if not fichier.is_file():
            print(f'  ? {fichier.name} — introuvable')
            ennuis += 1
            continue
        fautes, code = analyser_et_masquer(fichier.read_text(encoding='utf-8'))
        lus.append((fichier, code))
        if not fautes:
            print(f'  ✓ {fichier.name}')
            continue
        ennuis += len(fautes)
        print(f'  ✗ {fichier.name}')
        for ligne, quoi in fautes:
            print(f'      ligne {ligne} : {quoi}')
    if ennuis:
        print(f'\n{ennuis} faute(s). Le fichier ne chargera pas.')
        return 1

    partages = doublons(lus)
    if partages:
        print()
        for nom, lieux in sorted(partages.items()):
            print(f'  ✗ « {nom} » est déclaré dans : {", ".join(sorted(lieux))}')
        print()
        print('PHP s\'arrête sur un nom déclaré deux fois. Le plugin ne chargera')
        print('pas, et le site non plus.')
        return 1
    return 0


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
