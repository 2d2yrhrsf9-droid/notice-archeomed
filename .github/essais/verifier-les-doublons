#!/bin/sh
# Le contrôle des doublons tranche-t-il juste ?
#
# Il a manqué une fois un vrai doublon — la 3.29, qui arrêtait le site — puis,
# corrigé, s'est mis à voir des doublons où PHP n'en voit pas. Chaque cas
# ci-dessous en est un qu'il a déjà mal jugé, ou qu'il jugerait mal si l'on
# retouchait la façon dont il lit le code.
set -u
ICI=$(dirname "$0")
CONTROLE="$ICI/../../verifier-la-syntaxe"
D="$ICI/doublons"
FAUTES=0

essai() {
  attendu=$1; shift
  # « échoue » veut dire : a vu le doublon. Un contrôle qui plante — une
  # trace Python, une faute sans rapport — sort aussi en erreur, et
  # passerait pour un contrôle qui a bien jugé. On exige donc son message.
  sortie=$("$CONTROLE" "$@" 2>&1)
  code=$?
  if [ "$code" -eq 0 ]; then
    obtenu=passe
  elif printf '%s' "$sortie" | grep -q 'est déclaré dans'; then
    obtenu=echoue
  else
    obtenu="plante ($(printf '%s' "$sortie" | tail -n 1))"
  fi
  if [ "$obtenu" = "$attendu" ]; then
    echo "  ✓ $attendu : $*"
  else
    echo "::error::le contrôle des doublons $obtenu là où il devait $attendu : $*"
    FAUTES=$((FAUTES + 1))
  fi
}

essai echoue "$D/echoue-meme-fichier.php"
essai passe  "$D/passe-js-a.php" "$D/passe-js-b.php"
essai passe  "$D/passe-garde-a.php" "$D/passe-garde-b.php"
essai passe  "$D/passe-alternative-a.php" "$D/passe-alternative-b.php"
essai passe  "$D/passe-anonyme-a.php" "$D/passe-anonyme-b.php"
essai echoue "$D/echoue-vrai-a.php" "$D/echoue-vrai-b.php"

[ "$FAUTES" -eq 0 ] || exit 1
